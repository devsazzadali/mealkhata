# Mealkhata — environment template. NAMES ONLY: never put real values in
# this file, never commit a real .env. Real values go in the host dashboard
# (Vercel / Neon) or a local .env that is gitignored.
#
# Neon PostgreSQL (pooled + direct URLs, from the Neon dashboard):
DATABASE_URL=
DIRECT_URL=
#
# REQUIRED — JWT signing secret for custom auth (src/lib/auth.ts).
# The server FAILS CLOSED without it (login/signing throws, no default secret).
# Generate one with: openssl rand -hex 32
# and set the output as AUTH_SECRET in the host env / local .env.
AUTH_SECRET=
#
# OPTIONAL — production uploads only. If set, /api/upload uses Vercel Blob
# (requires `npm i @vercel/blob` on the deploy); if unset, uploads fall back
# to local public/uploads (dev only, ephemeral on serverless hosts).
BLOB_READ_WRITE_TOKEN=
